# Server Configuration
# Note: when using Docker Compose, PORT is set to 8080 in docker-compose.yml and this value is ignored.
# This setting only applies to standalone/non-Docker usage (e.g. npm run dev:server).
PORT=3001
NODE_ENV=production

# PostgreSQL Database (optional - enables room persistence)
# If not set, rooms are ephemeral and lost when empty
# DATABASE_URL=postgresql://user:password@host:5432/database

# CORS Configuration
# In production, set this to your frontend URL(s), comma-separated
# For single-server deployment where frontend and backend are on same domain,
# you can leave this empty or set it to your domain
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# For development, leave as default (handled by code)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Docker Compose credentials (required — docker compose up will fail without these)
# Copy this file to .env and set your own values before running docker compose up
DB_USER=
DB_PASSWORD=
